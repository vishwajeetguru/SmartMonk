{
  "expo": {
    "name": "SmartMonk",
    "slug": "smartmonk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/appIcon.png",
    "userInterfaceStyle": "light",
    "scheme": "smartmonk",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartmonk.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "amazonpay",
          "upi",
          "credpay",
          "bhim",
          "paytmmp",
          "phonepe",
          "tez",
          "navipay",
          "mobikwik",
          "myairtel",
          "popclubapp",
          "super",
          "kiwi",
          "simplypayupi",
          "whatsapp",
          "amazonpay",
          "upi",
          "credpay",
          "bhim",
          "paytmmp",
          "phonepe",
          "tez",
          "navipay",
          "mobikwik",
          "myairtel",
          "popclubapp",
          "super",
          "kiwi",
          "simplypayupi",
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icons/appIcon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/icons/appIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.smartmonk.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44b86d61-d2a3-4e64-ba25-b5482c174e81"
      }
    }
  }
}
